APP_NAME=AnHeng Security Inspection Service
APP_ENV=dev
APP_VERSION=0.1.0
API_PREFIX=/api
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# 恒脑凭据只放服务端环境变量，不提交真实值
HENGAN_BASE_URL=https://gc.das-ai.com
HENGAN_APP_KEY=
HENGAN_APP_SECRET=
HENGAN_AGENT_ID=
JWT_SECRET_KEY=change-me-in-development

# 仅开发环境；生产环境改为数据库初始化/密钥管理
DEV_ADMIN_PASSWORD=change-me-admin-password
DATABASE_URL=sqlite+pysqlite:///./.local/anheng.db
JWT_TTL_SECONDS=3600
HENGAN_TIMEOUT_SECONDS=90
HENGAN_MAX_CONCURRENCY=2
HENGAN_RETRY_ATTEMPTS=3
